@page "/note/new"
@page "/note-editor/{id:guid?}"
@page "/"

@inject NotesContainer _notesContainer
@inject NavigationManager Navigation

@code {
    [Parameter]
    public Guid? id { get; set; }

    private bool isEditing = false;
    private Note n = new Note(Guid.Empty, "", "");
    private List<Note> notes = new List<Note>();

    protected override void OnParametersSet()
    {
        System.Diagnostics.Debug.WriteLine("onparameterset page entered");

        isEditing = false;

        if (id.HasValue && id.Value != Guid.Empty)
        {
            var foundNote = _notesContainer.GetNotes().FirstOrDefault(x => x.Id == id);
            if (foundNote != null)
            {
                n = foundNote;
                isEditing = true;
                return;
            }
        }
        n = new Note(_notesContainer.GetId(), "", "");
        id = n.Id;
    }

    protected override async Task OnInitializedAsync()
    {
        await SynchronizateIt();
    }

    private async Task HandleSave()
    {

        if (n == null) return;
        if (!isEditing)
        {
            await _notesContainer.SaveNote(n.Id, n.Title, n.Content);
            isEditing = true;
            Navigation.NavigateTo($"/note-editor/{n.Id}");

        }
        else
        {
            await _notesContainer.UpdateNote((Guid)id, n);
            isEditing = true;
            Navigation.NavigateTo($"/note-editor/{(Guid)n.Id}");
        }

    }

    public async Task SynchronizateIt()
    {
        await _notesContainer.Synchronizate();
        await _notesContainer.GetNotesAsync();

        notes = _notesContainer.GetNotes();
        if (n.Id != Guid.Empty)
        {
            Navigation.NavigateTo($"/note-editor/{(Guid)n.Id}");
            return;
        }
        Navigation.NavigateTo("/");
    }

    public async Task Delete(Guid noteid)
    {
        if (noteid == Guid.Empty) return;
        await _notesContainer.DeleteNote((Guid)noteid);
        id = null;
        isEditing = false;
        Navigation.NavigateTo($"/");
    }
}

<div class="notes-layout">

    <button class="sync-button"
            @onclick="SynchronizateIt"
            title="Синхронизировать заметки"
            aria-label="Синхронизировать заметки">
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 7v5h-5" />
            <path d="M4 17v-5h5" />
            <path d="M5.64 9A7 7 0 0 1 17.5 6.5L20 12" />
            <path d="M18.36 15A7 7 0 0 1 6.5 17.5L4 12" />
        </svg>
    </button>

    <!-- Сайдбар -->
    <aside class="notes-sidebar">

        <div class="notes-sidebar-header">
            <h2 class="notes-sidebar-title">Недавние файлы</h2>

            <button class="notes-add-button"
                    title="Новая заметка"
                    @onclick='() => Navigation.NavigateTo("/note/new")'>
                +
            </button>
        </div>

        <div class="notes-list">
            @if (_notesContainer.GetNotes() != null)
            {
                System.Diagnostics.Debug.WriteLine("rendering page entered");

                foreach (Note note in _notesContainer.GetNotes().OrderByDescending(x => x.UpdatedAt))
                {
                    if (note == null) continue;

                    <div class="note-list-item @(n?.Id == note.Id ? "active" : "")"
                         @onclick="@(() => Navigation.NavigateTo($"/note-editor/{(Guid)note.Id}"))">

                        <div class="note-list-icon">N</div>

                        <span class="note-list-title">@note.Title</span>

                        <button class="note-delete-button"
                                title="Удалить"
                                @onclick="() => Delete((Guid)note.Id)"
                                @onclick:stopPropagation="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M4 7h16" />
                                <path d="M10 11v6" />
                                <path d="M14 11v6" />
                                <path d="M6 7l1 14h10l1-14" />
                                <path d="M9 7V4h6v3" />
                            </svg>
                        </button>

                    </div>
                }
            }

        </div>

    </aside>


    <!-- Редактор -->
    <main class="note-editor">

        <input class="note-editor-title"
               @bind="@n.Title"
               placeholder="Новая заметка" />

        <textarea class="note-editor-content"
                  @bind="@n.Content"
                  placeholder="Введите ваш текст..."></textarea>

        <div class="note-editor-actions">

            <button class="note-editor-button" title="Сохранить" @onclick="HandleSave">
                <svg viewBox="0 0 24 24">
                    <path d="M5 3h11l3 3v15H5V3z" />
                    <path d="M8 3v6h8V3" />
                    <path d="M8 21v-6h8v6" />
                </svg>
            </button>

            <button class="note-editor-button" title="Удалить" @onclick="() => Delete((Guid)id)">
                <svg viewBox="0 0 24 24">
                    <path d="M4 7h16" />
                    <path d="M10 11v6" />
                    <path d="M14 11v6" />
                    <path d="M6 7l1 14h10l1-14" />
                    <path d="M9 7V4h6v3" />
                </svg>
            </button>

        </div>

    </main>

</div>

