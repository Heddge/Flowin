@page "/register"

@inject NavigationManager Navigation
@inject AuthenticationManager authManager

@code {
    string name = "";
    string surname = "";
    string email = "";
    string password = "";
    string second_password = "";

    private async Task Registration()
        => await authManager.Registration(name, surname, email, password, second_password);

    private void GoToLogin()
        => Navigation.NavigateTo("/login");
}

<div class="auth-page">
    <section class="auth-card">

        <div class="auth-logo">N</div>

        <h1 class="auth-title">Создать аккаунт</h1>
        <p class="auth-subtitle">
            Зарегистрируйся в Flowin и храни свои идеи в одном месте.
        </p>

        <div class="auth-form">

            <div class="auth-field">
                <label for="register-name">Имя</label>
                <input id="register-name"
                       class="auth-input"
                       type="text"
                       placeholder="Введите имя"
                       autocomplete="given-name"
                       @bind="@name"/>
            </div>

            <div class="auth-field">
                <label for="register-surname">Фамилия</label>
                <input id="register-surname"
                       class="auth-input"
                       type="text"
                       placeholder="Введите фамилию"
                       autocomplete="family-name" 
                       @bind="@surname" />
            </div>

            <div class="auth-field">
                <label for="register-email">Email</label>
                <input id="register-email"
                       class="auth-input"
                       type="email"
                       placeholder="Введите email"
                       autocomplete="email" 
                       @bind="@email" />
            </div>

            <div class="auth-field">
                <label for="register-password">Пароль</label>
                <input id="register-password"
                       class="auth-input"
                       type="password"
                       placeholder="Придумайте пароль"
                       autocomplete="new-password" 
                       @bind="@password" />
            </div>

            <div class="auth-field">
                <label for="register-confirm-password">
                    Подтверждение пароля
                </label>
                <input id="register-confirm-password"
                       class="auth-input"
                       type="password"
                       placeholder="Повторите пароль"
                       autocomplete="new-password" 
                       @bind="@second_password" />
            </div>

            <button class="auth-submit" @onclick="Registration">
                Зарегистрироваться
            </button>

        </div>

        <p class="auth-footer">
            Уже есть аккаунт?
            <button class="auth-link"
                    @onclick="GoToLogin">
                Войти
            </button>
        </p>

    </section>
</div>

