
@page "/login"

@inject NavigationManager Navigation

<div class="auth-page">
    <section class="auth-card">

        <div class="auth-logo">N</div>

        <h1 class="auth-title">С возвращением</h1>
        <p class="auth-subtitle">
            Войди в Flowin, чтобы продолжить работу с заметками.
        </p>

        <div class="auth-form">

            <div class="auth-field">
                <label for="login-email">Email или имя пользователя</label>
                <input id="login-email"
                       class="auth-input"
                       type="text"
                       placeholder="Введите email или логин"
                       autocomplete="username" />
            </div>

            <div class="auth-field">
                <label for="login-password">Пароль</label>
                <input id="login-password"
                       class="auth-input"
                       type="password"
                       placeholder="Введите пароль"
                       autocomplete="current-password" />
            </div>

            <button class="auth-submit" @onclick="Login">
                Войти
            </button>

        </div>

        <p class="auth-footer">
            Нет аккаунта?
            <button class="auth-link"
                    @onclick="GoToRegister">
                Зарегистрироваться
            </button>
        </p>

    </section>
</div>

@code {
    private void Login()
    {
        // Позже здесь будет авторизация через API.
    }

    private void GoToRegister()
    {
        Navigation.NavigateTo("/register");
    }
}
