@page "/login"

@inject AuthenticationManager _authenticationManager
@inject LocalSessionContainer _localsessionmanager
@inject NavigationManager Navigation

@code {
    string email = "";
    string password = "";

    private async Task Logining()
    {
        var response = await _authenticationManager.Logining(email, password);
        if (response != null)
        {
            _localsessionmanager.SetUser(response);
            // System.Diagnostics.Debug.WriteLine(response.Name + " LOGGINED");
            Navigation.NavigateTo("/note/new");
        }
    }

    private void GoToRegister()
        => Navigation.NavigateTo("/register");
}

<div class="auth-page">
    <section class="auth-card">

        <div class="auth-logo">N</div>

        <h1 class="auth-title">С возвращением</h1>
        <p class="auth-subtitle">
            Войди во Flowin, чтобы продолжить работу с заметками.
        </p>

        <div class="auth-form">

            <div class="auth-field">
                <label for="login-email">Email</label>
                <input id="login-email"
                       class="auth-input"
                       type="text"
                       placeholder="Введите email или логин"
                       autocomplete="username"
                       @bind="@email" />
            </div>

            <div class="auth-field">
                <label for="login-password">Пароль</label>
                <input id="login-password"
                       class="auth-input"
                       type="password"
                       placeholder="Введите пароль"
                       autocomplete="current-password"
                       @bind="@password" />
            </div>

            <button class="auth-submit" @onclick="Logining">
                Войти
            </button>

        </div>

        <p class="auth-footer">
            Нет аккаунта?
            <button class="auth-link"
                    @onclick="GoToRegister">
                Зарегистрироваться
            </button>
        </p>

    </section>
</div>


