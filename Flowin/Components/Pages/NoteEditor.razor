@page "/note/new"
@page "/note-editor/{id:guid?}"
@page "/"

@inject LocalSessionContainer _localSessionContainer
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

@code {
    private ElementReference markdownEditorElement;
    private string? markdownEditorId;
    private Guid? editorNoteId;
    [Parameter]
    public Guid? id { get; set; }

    private string? pendingNewNoteAnimationId;


    private bool isEditing = false;
    private bool isAuthorized = false;
    private Note current_note = new Note(Guid.Empty, Guid.Empty, "", "");
    private User current_user = new User();
    private List<Note> notes = new List<Note>();

    private HashSet<Guid> deletingNotes = new();

    private bool sidebarToggled = false;

private void ToggleSidebar()
{
    sidebarToggled = !sidebarToggled;
}

    protected override async void OnParametersSet()
    {
        isEditing = false;
        current_user = _localSessionContainer.GetUser();
        if (current_user.Id != Guid.Empty)
        {
            isAuthorized = true;
            current_note.OwnerId = current_user.Id;
        }
        else
            current_note.OwnerId = Guid.Empty;

        notes = await _localSessionContainer.GetNotesAsync(current_user);

        if (id.HasValue && id != null)
        {
            var foundNote = notes.FirstOrDefault(x => x.Id == id);
            if (foundNote != null)
            {
                current_note = foundNote;
                System.Diagnostics.Debug.WriteLine("CURRENT NOTE ID -> " + current_note.Id);
                isEditing = true;
                return;
            }
        }

        current_note = new Note(Guid.Empty, _localSessionContainer.GetId(), "", "");
        id = current_note.Id;
        System.Diagnostics.Debug.WriteLine("CURRENT NOTE ID -> " + current_note.Id);

    }

    protected override Task OnInitializedAsync()
    {
        // await SynchronizateIt();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingNewNoteAnimationId != null)
        {
            string noteId = pendingNewNoteAnimationId;
            pendingNewNoteAnimationId = null;

            await JS.InvokeVoidAsync(
                "flowinNoteListAnimation.animate",
                noteId);
        }
        if (markdownEditorId == null)
        {
            markdownEditorId = await JS.InvokeAsync<string>(
                "blazorMarkdownEditor.create",
                markdownEditorElement,
                new { markdown = current_note.Content ?? "" });

            editorNoteId = current_note.Id;
            return;
        }

        if (editorNoteId != current_note.Id)
        {
            await JS.InvokeVoidAsync(
                "blazorMarkdownEditor.setMarkdown",
                markdownEditorId,
                current_note.Content ?? "");

            editorNoteId = current_note.Id;
        }
    }

    private bool showUserMenu = false;

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task Logout()
    {
        _localSessionContainer.Unauthorize();
        showUserMenu = false;
        current_note = new Note(Guid.Empty, Guid.Empty, "", "");
        notes = await _localSessionContainer.GetNotesAsync(current_user);
        Navigation.NavigateTo("/login");
    }

    private async Task HandleSave()
    {
        if (current_note == null) return;

        if (markdownEditorId != null)
        {
            current_note.Content = await JS.InvokeAsync<string>(
                "blazorMarkdownEditor.getMarkdown",
                markdownEditorId);
        }

        if (!isEditing)
        {
            // Запоминаем позиции существующих заметок
            await JS.InvokeVoidAsync("flowinNoteListAnimation.capture");

            if (isAuthorized)
                await _localSessionContainer.SaveNote(
                    current_user,
                    current_note.Id,
                    current_note.Title,
                    current_note.Content);
            else
                await _localSessionContainer.SaveNote(
                    current_note.Id,
                    current_note.Title,
                    current_note.Content);

            isEditing = true;

            // Запоминаем ID новой заметки для последующей анимации
            pendingNewNoteAnimationId = current_note.Id.ToString();

            Navigation.NavigateTo($"/note-editor/{current_note.Id}");
        }
        else
        {
            if (isAuthorized)
                await _localSessionContainer.UpdateNote(current_user, current_note);
            else
                await _localSessionContainer.UpdateNote(current_note);
            isEditing = true;
            Navigation.NavigateTo($"/note-editor/{(Guid)current_note.Id}");
        }

    }

    public async ValueTask DisposeAsync()
    {
        if (markdownEditorId != null)
        {
            await JS.InvokeVoidAsync(
                "blazorMarkdownEditor.destroy",
                markdownEditorId);

            markdownEditorId = null;
        }
    }

    public async Task SynchronizateIt()
    {
        await _localSessionContainer.Synchronizate();
        await _localSessionContainer.GetNotesAsync();

        notes = _localSessionContainer.GetNotes();
        if (current_note.Id != Guid.Empty)
        {
            Navigation.NavigateTo($"/note-editor/{(Guid)current_note.Id}");
            return;
        }
        Navigation.NavigateTo("/");
    }

    // public async Task Delete(Guid noteid)
    // {
    //     System.Diagnostics.Debug.WriteLine("CURRENT NOTE ID -> " +  noteid);
    //     if (noteid == Guid.Empty) return;
    //     await _localSessionContainer.DeleteNote(current_user, (Guid)noteid);
    //     id = null;
    //     isEditing = false;
    //     Navigation.NavigateTo($"/");
    // }
    public async Task Delete(Guid noteid)
    {
        if (noteid == Guid.Empty || !deletingNotes.Add(noteid))
            return;

        bool deletingCurrentNote = current_note.Id == noteid;

        await InvokeAsync(StateHasChanged);

        await Task.Delay(320);

        try
        {
            await _localSessionContainer.DeleteNote(current_user, noteid);

            notes.RemoveAll(x => x.Id == noteid);
        }
        finally
        {
            deletingNotes.Remove(noteid);
            await InvokeAsync(StateHasChanged);
        }

        if (deletingCurrentNote)
        {
            id = null;
            isEditing = false;
            Navigation.NavigateTo("/");
        }
    }
}

<div class="notes-layout @(sidebarToggled ? "sidebar-toggled" : "")">

    <div class="notes-top-actions">

    <button class="sidebar-toggle-button"
            @onclick="ToggleSidebar"
            title="Скрыть или показать панель"
            aria-label="Скрыть или показать панель">
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M9 4v16" />
        </svg>
    </button>

    <button class="sync-button"
            @onclick="SynchronizateIt"
            title="Синхронизировать заметки"
            aria-label="Синхронизировать заметки">
        <svg viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 7v5h-5" />
            <path d="M4 17v-5h5" />
            <path d="M5.64 9A7 7 0 0 1 17.5 6.5L20 12" />
            <path d="M18.36 15A7 7 0 0 1 6.5 17.5L4 12" />
        </svg>
    </button>

</div>

    <!-- Сайдбар -->
    <aside class="notes-sidebar">

        <div class="notes-sidebar-header">
            <h2 class="notes-sidebar-title">Недавние файлы</h2>

            <button class="notes-add-button"
                    title="Новая заметка"
                    @onclick='() => Navigation.NavigateTo("/note/new")'>
                +
            </button>
        </div>

        <div class="notes-list">
            @if (_localSessionContainer.GetNotes() != null)
            {
                if (id == null) id = Guid.Empty;
                @foreach (Note note in notes.OrderByDescending(x => x.UpdatedAt))
                {
                    if (note == null) continue;

                    <div @key="note.Id"
                         data-note-id="@note.Id"
                         class="note-list-item-shell @(deletingNotes.Contains(note.Id) ? "is-deleting" : "")">

                        <div class="note-list-item-clip">

                            <div class="note-list-item"
                                 @onclick="@(() => Navigation.NavigateTo($"/note-editor/{note.Id}"))">

                                <div class="note-list-icon">N</div>

                                <span class="note-list-title">@note.Title</span>

                                <button class="note-delete-button"
                                        title="Удалить"
                                        @onclick="() => Delete(note.Id)"
                                        @onclick:stopPropagation="true">

                                    <svg viewBox="0 0 24 24">
                                        <path d="M4 7h16" />
                                        <path d="M10 11v6" />
                                        <path d="M14 11v6" />
                                        <path d="M6 7l1 14h10l1-14" />
                                        <path d="M9 7V4h6v3" />
                                    </svg>

                                </button>

                            </div>

                        </div>
                    </div>
                }
            }

        </div>

        <div class="sidebar-account">

            @if (showUserMenu)
            {
                <div class="account-menu">
                    <button class="account-logout-button"
                            @onclick="Logout">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            @if (isAuthorized)
                            {
                                <path d="M10 17l5-5-5-5" />
                                <path d="M15 12H3" />
                                <path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" />
                            }
                            else
                            {
                                <path d="M14 17l-5-5 5-5" />
                                <path d="M9 12h12" />
                                <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7" />
                            }
                        </svg>

                        @(isAuthorized ? "Выйти" : "Войти")
                    </button>
                </div>
            }

            <button class="account-profile"
                    @onclick="ToggleUserMenu"
                    aria-expanded="@showUserMenu">

                <span class="account-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21a8 8 0 0 1 16 0" />
                    </svg>
                </span>

                <span class="account-name">
                    @(isAuthorized? _localSessionContainer.CurrentUser.Name : "Войдите для синхронизации")
                </span>

                <span class="account-chevron @(showUserMenu ? "rotated" : "")">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M6 9l6 6 6-6" />
                    </svg>
                </span>

            </button>
        </div>
    </aside>


    <!-- Редактор -->
    <main class="note-editor">

        <input class="note-editor-title"
               @bind="@current_note.Title"
               placeholder="Новая заметка" />

        <div class="note-editor-content"
             @ref="markdownEditorElement"
             spellcheck="false">
        </div>

        <div class="note-editor-actions">

            <button class="note-editor-button" title="Сохранить" @onclick="HandleSave">
                <svg viewBox="0 0 24 24">
                    <path d="M5 3h11l3 3v15H5V3z" />
                    <path d="M8 3v6h8V3" />
                    <path d="M8 21v-6h8v6" />
                </svg>
            </button>

            <button class="note-editor-button" title="Удалить" @onclick="() => Delete(current_note.Id)">
                <svg viewBox="0 0 24 24">
                    <path d="M4 7h16" />
                    <path d="M10 11v6" />
                    <path d="M14 11v6" />
                    <path d="M6 7l1 14h10l1-14" />
                    <path d="M9 7V4h6v3" />
                </svg>
            </button>

        </div>

    </main>

</div>

